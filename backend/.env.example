# Copy to backend/.env and fill in. Never commit .env.

# Long random string. Generate one with:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# true only on your own machine
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Homebrew Postgres 17 runs on port 5433 (5432 is used by the EDB Postgres 16 install)
DATABASE_URL=postgres://localhost:5433/hindustan_electric

# Where the React app runs
CORS_ALLOWED_ORIGINS=http://localhost:3000
